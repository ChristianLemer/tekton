# macOS
.DS_Store

# IDE-pasted images (saved next to agent .md files)
**/agents/image/

# Authoring-time workspace config — not part of the plugin distribution
# (`.claude-plugin/` is the distribution and stays tracked)
.claude/

# Local overrides — Claude Code convention, never committed
CLAUDE.local.md
*.local.code-workspace

# Throwaway working notes — same convention as architekton (`_PLAN.md`)
_*

# Machine-local tooling. `publish` carries the employer's shared-library path in
# clear — it publishes from one machine only, and that is why it stays out.
# Excluded from the Saul mirror already (`admin/publish/excludes.txt`).
#
# The exclusion was applied to the whole directory, and it cost the validation
# gate: the file that carried it stopped being versioned, so a `rm` would lose
# it without trace. What is clean is tracked, one module at a time.
admin/*
!admin/manifest/
!admin/verify/

# Editor temporaries
*.swp
*.swo

# Logs
*.log

# Future-proofing for hook dependencies (none today, but cheap to ignore upfront)
node_modules/
__pycache__/
*.pyc
